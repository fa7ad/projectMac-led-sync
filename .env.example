# Copy this file to .env and fill in your own lamp's pairing keys.
# These are specific to one Tuya BLE-beacon device + account pairing —
# never commit the filled-in .env, only this template.
#
# LAMP_LOCAL_KEY: the device's standard Tuya Cloud API `local_key` (16
#   ASCII characters, used directly as bytes — not hex-decoded).
# LAMP_APP_KEY: the account/home-scoped Tuya "Beacon Mesh AppKey" (32 hex
#   characters). Obtained via the private `thing.m.device.beacon.mesh.create`
#   mobile API call — not available through any public Tuya Cloud/Open API
#   endpoint.
# LAMP_SRC_ADDR / LAMP_DST_ADDR: 2-byte (4 hex char) mesh addressing fields
#   from a real captured beacon frame. LAMP_DST_ADDR is very likely this
#   specific device's fixed mesh address; LAMP_SRC_ADDR's requirements are
#   unverified (a captured value is known to work, untested whether the
#   lamp accepts anything else).

LAMP_LOCAL_KEY=YOUR16CHARLOCALKEY
LAMP_APP_KEY=00000000000000000000000000000000
LAMP_SRC_ADDR=0000
LAMP_DST_ADDR=0000

# Path to the ESP32 bridge's serial device (e.g. /dev/tty.usbserial-XXXX on
# macOS/Linux, COM3 on Windows). Omit/leave blank to run in dry-run mode
# (frames computed but not sent — no hardware needed).
BRIDGE_SERIAL_PORT=/dev/tty.usbserial-XXXX
